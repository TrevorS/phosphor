  0 │   1  //! Retry policy — exponential backoff with jitter for the fetch client.                                          │
  1 │   2  //! Used by `fetch::request` when a transient error is retried.                                                   │
  2 │   3                                                                                                                    │
  3 │   4  use util::jitter;                                                                                                 │
  4 │   5                                                                                                                    │
  5 │   6  pub struct RetryPolicy {                                                                                          │
  6 │   7      pub max_attempts: u32,                                                                                        │
  7 │   8      pub base_delay: Duration,                                                                                     │
  8 │   9      pub max_delay: Duration,                                                                                      │
  9 │  10  }                                                                                                                 │
 10 │  11                                                                                                                    │
 11 │  12  pub fn retry_with_backoff<T, E>(                                                                                  │
 12 │  13      mut op: impl FnMut() -> Result<T, E>,                                                                         │
 13 │  14      policy: &RetryPolicy,                                                                                         │
 14 │  15  ) -> Result<T, E> {                                                                                               │
 15 │  16      let mut delay = policy.base_delay;                                                                            │
 16 │  17      let mut last = None;                                                                                          │
 17 │  18      for attempt in 0..policy.max_attempts {                                                                       │
 18 │  19          match op() {                                                                                              │
 19 │  20              Ok(v) => return Ok(v),                                                                                │
 20 │  21              Err(e) => last = Some(e),                                                                             │
 21 │  22          }                                                                                                         │
 22 │  23          thread::sleep(jitter(delay));                                                                             │
 23 │ NORMAL  src/retry.rs                                                                                          2 unseen │

