  0 │   1  pub fn retry_with_backoff<T, E>(                                          │
  1 │   2      mut op: impl FnMut() -> Result<T, E>,                                 │
  2 │   3      policy: &RetryPolicy,                                                 │
  3 │   4  ) -> Result<T, E> {                                                       │
  4 │   5      let mut delay = policy.base_delay;                                    │
  5 │   6      for attempt in 0..policy.max_attempts {                               │
  6 │   7          match op() {                                                      │
  7 │   8              Ok(v) => return Ok(v),                                        │
  8 │   9              Err(e) => thread::sleep(jitter(delay)),                       │
  9 │  10          }                                                                 │
 10 │  11          delay = (delay * 2).min(policy.max_delay);                        │
 11 │  12      }                                                                     │
 12 │  13      Err(last.unwrap())                                                    │
 13 │  14  }                                                                         │
